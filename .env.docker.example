# Copy this file to .env.docker if you want Docker data on E: instead of the repo.
# Run with:
#   docker compose --env-file .env.docker up --build

SPEECHRECON_DOCKER_PORT=5000

# Optional. Required only for gated/private Hugging Face repositories.
# This is intentionally not named HF_TOKEN so Docker Compose does not
# accidentally import the token from the normal local .env file.
SPEECHRECON_HF_TOKEN=

# Docker Desktop accepts forward-slash Windows paths.
SPEECHRECON_HOST_DATA=E:/speechRecon-docker/data
SPEECHRECON_HOST_UPLOADS=E:/speechRecon-docker/uploads
SPEECHRECON_HOST_LOGS=E:/speechRecon-docker/logs
SPEECHRECON_HOST_MODEL_CACHE=E:/speechRecon-docker/models
SPEECHRECON_HOST_DATASET_CACHE=E:/speechRecon-docker/datasets
SPEECHRECON_HOST_HF_CACHE=E:/speechRecon-docker/huggingface
