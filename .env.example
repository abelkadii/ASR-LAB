FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=0

# Optional. Required only for gated/private Hugging Face repos.
HF_TOKEN=

# Keep downloaded assets outside Git.
SPEECHRECON_CACHE_ROOT=E:\speechRecon-cache
SPEECHRECON_MODEL_DIR=E:\speechRecon-cache\models
SPEECHRECON_DATASET_DIR=E:\speechRecon-cache\datasets
HF_HOME=E:\speechRecon-cache\huggingface
HF_HUB_CACHE=E:\speechRecon-cache\huggingface\hub
TRANSFORMERS_CACHE=E:\speechRecon-cache\huggingface\hub
HF_DATASETS_CACHE=E:\speechRecon-cache\huggingface\datasets
